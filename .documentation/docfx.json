{
  "build": {
    "content": [
      {
        "files": ["*.md", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      },
      {
        "files": ["media/**"]
      }
    ],
    "overwrite": [],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": ["default", "modern"],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_googleAnalyticsTagId": "G-RY77Z11S9E",
      "_appTitle": "DevSpark",
      "_appName": "DevSpark",
      "_appFooter": "<a href=\"https://dev.makeboldspark.com\">DevSpark</a> &mdash; built by <a href=\"https://markhazleton.com\">Mark Hazleton</a> &middot; <a href=\"https://makeboldsolutions.com\">Make Bold Solutions</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/MarkHazleton/devspark",
        "branch": "main"
      }
    }
  }
}
