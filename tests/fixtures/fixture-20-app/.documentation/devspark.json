{
  "version": 1,
  "mode": "multi-app",
  "profiles": {
    "repo-default": {
      "rules": [
        "All services must follow semantic versioning for releases.",
        "Every service must include a README.md with setup instructions."
      ]
    },
    "api-profile": {
      "rules": [
        "API services must validate all input payloads against a JSON schema.",
        "API responses must include standard error envelopes with correlation IDs."
      ]
    },
    "web-profile": {
      "rules": [
        "Web apps must achieve Lighthouse accessibility score >= 90.",
        "Web apps must implement CSP headers in production."
      ]
    }
  },
