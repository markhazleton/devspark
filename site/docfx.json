{
  "build": {
    "content": [
      {
        "src": "src",
        "files": [
          "*.md",
          "toc.yml",
          "get-started/**.md",
          "get-started/toc.yml",
          "guides/**.md",
          "guides/toc.yml",
          "why/**.md",
          "why/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "src": "src",
        "files": [
          "images/**"
        ]
      },
      {
        "src": "src",
        "files": [
          "media/**"
        ]
      }
    ],
    "overwrite": [],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "templates/devspark"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_googleAnalyticsTagId": "G-RY77Z11S9E",
      "_appTitle": "Make Bold Solutions",
      "_appName": "DevSpark",
      "_appLogoPath": "media/brand/logo/makeboldsolutions-mark.svg",
      "_appFaviconPath": "media/brand/favicon/favicon.ico",
      "_appFooter": "<a href=\"https://dev.makeboldspark.com\">DevSpark</a> by <a href=\"https://makeboldsolutions.com\">Make Bold Solutions</a> &middot; built by <a href=\"https://markhazleton.com\">Mark Hazleton</a> &middot; part of the <a href=\"https://makeboldspark.com\">Make Bold Spark</a> family",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/MarkHazleton/devspark",
        "branch": "main"
      }
    }
  }
}
