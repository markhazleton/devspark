{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspark.local/schemas/devspark-evidence.schema.json",
  "title": "DevSpark v4 Evidence Entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "ref", "verified_by"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["test", "code"]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "verified_by": {
      "type": "string",
      "enum": ["execution", "inspection"]
    },
    "test_attempted": {
      "type": "boolean"
    },
    "fallback_reason": {
      "type": "string"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "test" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "verified_by": { "const": "execution" } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "code" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "verified_by": { "const": "inspection" } }
      }
    }
  ]
}
