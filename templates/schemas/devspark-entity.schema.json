{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspark.local/schemas/devspark-entity.schema.json",
  "title": "DevSpark v4 Entity Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "kind", "summary", "evidence"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "knowledge-model",
        "framework-template-set",
        "generated-integration-files",
        "repository-configuration",
        "ephemeral-state",
        "knowledge-site",
        "design-asset-set",
        "integration-catalog",
        "contributor-practice"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "object"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "describes",
              "derives_from",
              "extends",
              "generated_for",
              "scopes",
              "supports",
              "uses",
              "validates",
              "validated_by"
            ]
          },
          "object": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "default": []
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": ["current", "transitional", "retired"],
      "default": "current"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "managed_by": {
      "type": "string",
      "enum": ["human", "prompt", "script", "generated", "mixed"]
    },
    "required_layers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+\\.md$"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "devspark-evidence.schema.json"
      }
    }
  }
}
