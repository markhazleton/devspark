{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devspark.local/schemas/devspark-decision.schema.json",
  "title": "DevSpark v4 Decision Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "status", "constrains", "evidence"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "enum": ["current", "deprecated"]
    },
    "constrains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "devspark-evidence.schema.json"
      }
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
